<mujoco model="a1 standup scene - stairs">
  <include file="a1.xml"/>
  <option timestep="0.002" iterations="100" ls_iterations="50" noslip_iterations="10"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.35 0.4 0.45" rgb2="0.25 0.3 0.35"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="step_mat" texture="groundplane" texuniform="true" texrepeat="2 2" reflectance="0.2"/>
  </asset>
  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="terrain" type="plane" size="5 5 0.1" pos="0 0 0" material="groundplane" condim="3"
      friction="0.8 0.02 0.01" solimp="0.99 0.999 0.0005 0.5 2" solref="0.002 1"/>

    <!-- Discrete rigid stairs: width along Y reduced from 5.0m to 2.5m; tread depth 0.45m, height 0.08m -->
    <geom name="step_n1" type="box" size="0.225 1.25 0.040" pos="-0.45 0 0.040" material="step_mat" condim="3"
      friction="0.8 0.02 0.01" solimp="0.99 0.999 0.0005 0.5 2" solref="0.002 1"/>
    <geom name="step_0" type="box" size="0.225 1.25 0.080" pos="0.00 0 0.080" material="step_mat" condim="3"
      friction="0.8 0.02 0.01" solimp="0.99 0.999 0.0005 0.5 2" solref="0.002 1"/>
    <geom name="step_1" type="box" size="0.225 1.25 0.120" pos="0.45 0 0.120" material="step_mat" condim="3"
      friction="0.8 0.02 0.01" solimp="0.99 0.999 0.0005 0.5 2" solref="0.002 1"/>
    <geom name="step_2" type="box" size="0.225 1.25 0.160" pos="0.90 0 0.160" material="step_mat" condim="3"
      friction="0.8 0.02 0.01" solimp="0.99 0.999 0.0005 0.5 2" solref="0.002 1"/>
    <geom name="step_3" type="box" size="0.225 1.25 0.200" pos="1.35 0 0.200" material="step_mat" condim="3"
      friction="0.8 0.02 0.01" solimp="0.99 0.999 0.0005 0.5 2" solref="0.002 1"/>
    <geom name="step_4" type="box" size="0.225 1.25 0.240" pos="1.80 0 0.240" material="step_mat" condim="3"
      friction="0.8 0.02 0.01" solimp="0.99 0.999 0.0005 0.5 2" solref="0.002 1" />
    <geom name="step_5" type="box" size="0.85 1.25 0.280" pos="2.875 0 0.280" material="step_mat" condim="3"
      friction="0.8 0.02 0.01" solimp="0.99 0.999 0.0005 0.5 2" solref="0.002 1"/>
  </worldbody>
</mujoco>
